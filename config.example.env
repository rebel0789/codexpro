# Copy to .envrc or source manually before running npm run start:http.
CODEXPRO_ROOT=/absolute/path/to/your/repo
CODEXPRO_ALLOWED_ROOTS=/absolute/path/to/your/repo
CODEXPRO_HOST=127.0.0.1
CODEXPRO_PORT=8787
CODEXPRO_BASH_MODE=safe
# Pin the exact Codex CLI seen by foreground and durable shell jobs. Recommended for services/launchd.
# CODEXPRO_CODEX_BIN=/Users/you/.local/bin/codex
# A custom Codex directory is forwarded to detached Codex as CODEX_HOME.
# CODEXPRO_CODEX_DIR=/Users/you/.codex
# CodingTask keeps one private worktree and one persistent context across direct coding and Codex collaboration.
# Keep this directory outside every allowed project. Defaults: ~/.codexpro/tasks, gpt-5.6-sol, high.
# CodingTask create/run/follow-up and Direct -> Codex require BOTH active settings to be changed explicitly:
# CODEXPRO_BASH_MODE=full
# CODEXPRO_WRITE_MODE=workspace
# Status/list/review/cancel and Codex -> Direct remain available with this example's safer defaults.
# CODEXPRO_TASK_DIR=/Users/you/.codexpro/tasks
# CODEXPRO_CODEX_MODEL=gpt-5.6-sol
# CODEXPRO_CODEX_REASONING_EFFORT=high
# CODEXPRO_CODING_TASK_TIMEOUT_MS=21600000
# CODEXPRO_CODING_TASK_MAX_LOG_BYTES=10485760
# Optional hard cap for bash tool timeout_ms. Default 600000 (10m), max 900000 (15m).
# CODEXPRO_MAX_BASH_TIMEOUT_MS=600000
# Max bytes for import_file ChatGPT attachment downloads. Default 5000000.
# CODEXPRO_MAX_IMPORT_BYTES=5000000
# Extra approved HTTPS hosts for import_file, comma-separated. Loopback stays blocked unless explicitly enabled for tests.
# CODEXPRO_IMPORT_ALLOWED_HOSTS=files.oaiusercontent.com
# CODEXPRO_IMPORT_ALLOW_LOOPBACK=0
# Optional local bash session guard. If required, bash tool calls must include the matching session_id.
# CODEXPRO_BASH_SESSION_ID=main
# CODEXPRO_REQUIRE_BASH_SESSION=1
# Durable jobs survive MCP/server reconnects and store private state outside the workspace.
# CODEXPRO_JOB_DIR=/Users/you/.codexpro/jobs
# CODEXPRO_BACKGROUND_JOB_TIMEOUT_MS=21600000
# CODEXPRO_BACKGROUND_JOB_MAX_LOG_BYTES=10485760
CODEXPRO_WRITE_MODE=handoff
CODEXPRO_TOOL_MODE=standard
# Dedicated HTTPS origin for ChatGPT widget iframes. Required for app submission.
CODEXPRO_WIDGET_DOMAIN=https://rebel0789.github.io

# Disabled by default so ChatGPT receives plain MCP tool descriptors.
# Set to 1 only if you want CodexPro's custom ChatGPT cards.
CODEXPRO_TOOL_CARDS=0
# At least 24 UTF-8 bytes. Prefer the generated random token from codexpro setup/start.
CODEXPRO_HTTP_TOKEN=replace-with-a-long-random-token
# Require a token even for loopback binds. Non-loopback and tunnel mode require one unless explicitly overridden.
# CODEXPRO_REQUIRE_HTTP_TOKEN=1
# CODEXPRO_ALLOW_NO_HTTP_TOKEN=1
CODEXPRO_CONTEXT_DIR=.ai-bridge
# Optional stable public URL mode. Quick tunnels do not keep the same hostname.
# CODEXPRO_TUNNEL=cloudflare-named
# CODEXPRO_PUBLIC_HOSTNAME=codexpro.example.com
# CLOUDFLARE_TUNNEL_NAME=codexpro
# Or use a dashboard-managed tunnel token:
# CLOUDFLARE_TUNNEL_TOKEN_FILE=/Users/you/.codexpro/cloudflare-tunnel-token
# Optional comma-separated extra block list:
# CODEXPRO_BLOCKED_GLOBS=**/secrets/**,**/*.sqlite,**/*.db
